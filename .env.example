# Public hostname served by nginx-proxy (also used for Host header validation)
VIRTUAL_HOST=garmin-mcp.gcourtot.fr

# Secret protecting the MCP endpoint (>= 32 chars): openssl rand -hex 32
MCP_API_KEY=

# Personal API key from Garmin Connect web > Personal API Key (shown only once, has an expiry)
GARMIN_PERSONAL_API_KEY=
